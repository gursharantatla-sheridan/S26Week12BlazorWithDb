@page "/products"
@inject AppDbContext Db

<h3>Product List</h3>

@if (products == null)
{
    <p>No products found.</p>
}
else
{
    <ul>
        @foreach (var p in products)
        {
            <li>@p.ProductName - @p.Price?.ToString("C")</li>
        }
    </ul>
}

@code {
    private List<Product>? products;

    protected override void OnInitialized()
    {
        products = Db.Products.ToList();
    }
}
